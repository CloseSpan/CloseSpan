# The repository defaults to safe, visibly simulated demo behavior.
APP_MODE=demo

# Production mode refuses mutating API calls unless they arrive from an
# authenticated trusted proxy carrying this shared secret. Store it in KMS.
AUTH_TRUSTED_PROXY=false
TRUSTED_PROXY_SECRET=

DATABASE_URL=postgresql://feedbackflow:feedbackflow@localhost:5432/feedbackflow
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
