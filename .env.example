# Use demo only for local seeded evaluation. Production requires a Google
# session whose verified email exists in workspace_members.
APP_MODE=production

# Google is the only sign-in provider. Create an OAuth 2.0 Web client and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
# Generate AUTH_SECRET with: openssl rand -hex 32. Docker and reverse-proxy
# deployments must sanitize forwarded host headers before enabling trust.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Provision the first production owner after migrate:
# PRODUCTION_OWNER_EMAIL=you@company.com \
# PRODUCTION_OWNER_NAME="Your Name" \
# npm run db:provision-owner
PRODUCTION_OWNER_EMAIL=
PRODUCTION_OWNER_NAME=
PRODUCTION_ORG_ID=org_feelow
PRODUCTION_ORG_NAME=Feelow AI

# Optional GitHub App install link shown during workspace setup.
GITHUB_APP_INSTALL_URL=

# Nango manages connector OAuth credentials outside Feelow. Use the API key for
# the same Nango environment as these integration Unique Keys. The webhook
# signing key is a separate secret from the API key and is required to accept
# Nango auth/sync events at /api/integrations/nango/webhook.
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
# Exact Nango environment name, normalized to uppercase (DEV, PROD, STAGING).
NANGO_ENVIRONMENT=DEV
# Optional for Nango Cloud; set this to the API origin for a self-hosted Nango.
NANGO_HOST=

# These values are Nango integration Unique Keys, not OAuth client IDs. They
# must exactly match the integrations configured in the selected Nango
# environment. Defaults are shown for local setup and may be renamed.
NANGO_ZENDESK_INTEGRATION_ID=zendesk
NANGO_INTERCOM_INTEGRATION_ID=intercom
NANGO_SLACK_INTEGRATION_ID=slack
NANGO_APP_STORE_INTEGRATION_ID=apple-app-store
NANGO_GOOGLE_PLAY_INTEGRATION_ID=google-play
NANGO_GITHUB_INTEGRATION_ID=github-getting-started

# Vercel sends this as `Authorization: Bearer $CRON_SECRET` to the durable
# reconciliation worker. Use at least 16 random characters. Successful Nango
# webhooks enqueue work immediately; this job recovers abandoned/retryable work.
CRON_SECRET=
NANGO_SYNC_MAX_JOBS=5
NANGO_SYNC_MAX_PAGES_PER_JOB=20
NANGO_SYNC_WEBHOOK_MAX_JOBS=6
NANGO_SYNC_WEBHOOK_MAX_PAGES=5
NANGO_SYNC_PAGE_SIZE=100
NANGO_SYNC_LEASE_MS=300000
NANGO_SYNC_WORKER_BUDGET_MS=45000

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://feedbackflow:feedbackflow_local@localhost:5432/feedbackflow
DATABASE_SSL=false
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# Required before API keys can be saved from Settings. Generate 32 random bytes
# and store the base64 value only in .env.local or KMS/Secrets Manager.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER=xai
AI_MODEL=grok-4.5
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=3000

# Environment-managed credentials remain supported as a fallback. Settings-
# managed credentials are encrypted per organization and take precedence.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6

# Optional public-feedback URL discovery. This sends only the product name (or
# public product hostname) to You.com; it does not send private connector data.
# Keep disabled until a workspace explicitly opts in and a server-side key is
# configured. `YDC_API_KEY` is also accepted as a legacy key name.
YOU_PUBLIC_DISCOVERY_ENABLED=false
YOU_API_KEY=
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search
YOU_PUBLIC_DISCOVERY_TIMEOUT_MS=8000

# Reserved provider-neutral fallback boundary. It remains inert until a
# dataset-specific Bright Data client is deliberately injected server-side.
BRIGHT_DATA_PUBLIC_DISCOVERY_ENABLED=false

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
