# Use demo only for local seeded evaluation. Production requires a Google
# session whose verified email exists in workspace_members.
APP_MODE=production

# Google is the only sign-in provider. Create an OAuth 2.0 Web client and add
# both of these authorized redirect URIs in Google Cloud:
# http://localhost:3000/api/auth/callback/google
# https://closespan.com/api/auth/callback/google
# Keep AUTH_URL on localhost for development. In Vercel Production, override it
# with the canonical origin only: AUTH_URL=https://closespan.com
# Generate AUTH_SECRET with: openssl rand -hex 32. Docker and reverse-proxy
# deployments must sanitize forwarded host headers before enabling trust.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Preferred dedicated HMAC secret for the public feature-request board. It
# prevents duplicate IP votes without storing raw IP addresses. Generate at
# least 32 random bytes. This is required in production and must stay stable.
FEATURE_REQUEST_IP_SECRET=
# Comma-separated Google emails allowed to publish or reject public requests.
# PRODUCTION_OWNER_EMAIL is also accepted as a moderator.
FEATURE_REQUEST_MODERATOR_EMAILS=
# Vercel client IP headers are trusted automatically. For a non-Vercel
# production deployment, set this only when the app is unreachable except
# through a controlled reverse proxy that replaces X-Forwarded-For.
FEATURE_REQUEST_TRUST_PROXY=false

# Cloudflare Turnstile protects anonymous feature-request submissions and
# votes. Create one Managed widget restricted to closespan.com, then configure
# the public site key and server-only secret in every production environment.
# Local development falls back to Cloudflare's documented always-pass test
# keys when these values are empty. Never use test keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.closespan.com

# Optional search-engine ownership tokens. Add the exact values supplied by
# Google Search Console and Bing Webmaster Tools before the production build.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Provision the first production owner after migrate:
# PRODUCTION_OWNER_EMAIL=you@company.com \
# PRODUCTION_OWNER_NAME="Your Name" \
# npm run db:provision-owner
PRODUCTION_OWNER_EMAIL=
PRODUCTION_OWNER_NAME=
PRODUCTION_ORG_ID=org_feelow
PRODUCTION_ORG_NAME=Closespan

# GitHub App installation link shown during workspace setup. Configure the App's
# post-install Setup URL as:
# https://closespan.com/api/integrations/github/callback
GITHUB_APP_INSTALL_URL=https://github.com/apps/closespan/installations/new

# Pipedream Connect manages each customer's provider credentials. Create a
# Pipedream Connect project and copy its project OAuth credentials here.
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ENVIRONMENT=development
# Optional app-slug overrides when your Pipedream catalog uses custom slugs.
PIPEDREAM_APP_ZENDESK=zendesk
PIPEDREAM_APP_INTERCOM=intercom
PIPEDREAM_APP_SLACK=slack
PIPEDREAM_APP_APP_STORE=app-store-connect
PIPEDREAM_APP_PLAY_STORE=google-play
PIPEDREAM_APP_GITHUB=github

# Authorizes the minute scheduler for Slack intake and one-at-a-time workflow
# advancement. Use at least 16 random characters and store the same value in
# the Cloudflare workflow scheduler.
CRON_SECRET=

# Transactional prompt-review email alerts use Cloudflare Email Service's REST
# API because the Next.js app runs outside Workers. The sender domain must be
# onboarded in Cloudflare Email Sending. Use a token scoped only to Email Send.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
WAITLIST_APPROVAL_EMAIL_FROM=hello@closespan.com
PROMPT_REVIEW_EMAIL_FROM=notifications@closespan.com

# Keep PostgreSQL as the global source of truth. This optional ID routes only
# the seeded demo workspace to isolated memory while newly created
# organizations remain durable in PostgreSQL.
PERSISTENCE_MODE=postgres
DEMO_MEMORY_ORG_ID=org_northstar
DATABASE_URL=postgresql://feedbackflow:feedbackflow_local@localhost:5432/feedbackflow
DATABASE_SSL=false
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# Optional Flexprice shadow metering. CloseSpan always records the durable local
# billing ledger after migration. Enable delivery only after creating the
# matching Flexprice meters; no charges or entitlements are enforced in shadow
# mode. API keys are server-only. Use the API base URL for your Flexprice region.
FLEXPRICE_SHADOW_ENABLED=false
FLEXPRICE_API_KEY=
FLEXPRICE_API_BASE_URL=https://us.api.flexprice.io/v1
FLEXPRICE_TIMEOUT_MS=10000

# Required before API keys can be saved from Settings. Generate 32 random bytes
# and store the base64 value only in .env.local or KMS/Secrets Manager.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-sol
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=3000

# Environment-managed credentials remain supported as a fallback. Settings-
# managed credentials are encrypted per organization and take precedence.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6

# Optional public-feedback URL discovery. This sends only the product name (or
# public product hostname) to You.com; it does not send private connector data.
# Keep disabled until a workspace explicitly opts in and a server-side key is
# configured. `YDC_API_KEY` is also accepted as a legacy key name.
YOU_PUBLIC_DISCOVERY_ENABLED=false
YOU_API_KEY=
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search
YOU_PUBLIC_DISCOVERY_TIMEOUT_MS=8000

# Reserved provider-neutral fallback boundary. It remains inert until a
# dataset-specific Bright Data client is deliberately injected server-side.
BRIGHT_DATA_PUBLIC_DISCOVERY_ENABLED=false

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
# Server-only GitHub App key used for scoped archive reads and draft-PR writes.
# Keep the legacy GITHUB_PRIVATE_KEY above only for older integration code.
GITHUB_APP_PRIVATE_KEY=
# Optional dedicated HMAC secret for the 10-minute, one-time GitHub installation
# handoff. AUTH_SECRET is used when this is omitted.
GITHUB_INSTALL_STATE_SECRET=
# High-entropy secret shared only with the GitHub App webhook configuration.
GITHUB_WEBHOOK_SECRET=

# Approval-bound coding executor. AGENT_EXECUTOR_SHARED_SECRET must be the
# same high-entropy secret in Vercel and the Cloudflare Worker. The callback
# base URL must be the public CloseSpan origin; callbacks are HMAC signed.
AGENT_EXECUTOR_URL=
AGENT_EXECUTOR_SHARED_SECRET=
# Keep the approval-bound coding agent independent from product-facing AI.
# The balanced model is optimized for bounded tool loops inside the VM lease.
AGENT_EXECUTOR_MODEL=gpt-5.6-terra
# PDD is MIT-licensed, but local-mode model calls and runner compute are billed
# by their respective providers. The runner is a separate networked planner;
# generated tests are hash-locked before entering network-disabled Tenki sessions.
PDD_RUNNER_URL=
PDD_RUNNER_SHARED_SECRET=
PDD_MAX_BUDGET_USD=0.25
PDD_MODEL=gpt-5.4
# Tenki is the preferred host for the network-enabled PDD runner. Its sticky VM
# remains alive until explicitly closed. PDD_RUNNER_URL is the stable Tenki
# PreviewUrl; rotation rebinds that URL to a healthy replacement session.
PDD_RUNNER_STABLE_SLUG=closespan-pdd-production
PDD_RUNNER_ROTATION_MAX_AGE_DAYS=21
# Allow already accepted jobs to finish on the previous runner after cutover.
PDD_RUNNER_DRAIN_MS=300000
# Set only for an operator-initiated rotation; the scheduled workflow supplies
# this value from its boolean force input.
PDD_RUNNER_FORCE_ROTATION=false
# This is the candidate provisioning ceiling accepted by Tenki. Sticky runners
# remain alive until explicitly closed; the stable PreviewUrl has no TTL.
TENKI_PDD_RUNNER_MAX_DURATION_MS=2592000000
PDD_RUNNER_CONCURRENCY=2
# Configure this key in the Node application for coding execution and independent
# verification. The Cloudflare queue coordinator does not receive it. Tenki
# sessions have no network access and receive only the approved repository snapshot.
TENKI_API_KEY=
# The coding agent uses the OpenAI configuration declared above. If it is absent,
# the existing OpenAI-compatible xAI configuration remains an optional fallback.
# AI credentials stay in the Node runtime and are never copied into a Tenki session.
# XAI_API_KEY, XAI_BASE_URL, and XAI_MODEL are defined with the other AI provider
# settings above and are accepted as the production fallback.
# Fail production runs when the key is absent instead of skipping verification.
TENKI_VERIFICATION_REQUIRED=false
# Managed environment catalog. Bootstrap with both flags false, reconcile and
# validate at least one catalog artifact, refresh detected profiles, then enable
# both flags together. With managed catalog enabled, strict mode defaults on
# unless it is explicitly disabled for that one-time bootstrap.
TENKI_MANAGED_CATALOG_ENABLED=false
TENKI_STRICT_CATALOG_ENABLED=false
TENKI_CATALOG_RETENTION_DAYS=14
TENKI_CACHE_RETENTION_DAYS=30
TENKI_PRIVATE_BUILD_LIMIT=3
# Legacy compatibility only for already-queued schema-v1 jobs. New execution
# profiles must use a validated digest-pinned image from the managed catalog.
TENKI_SANDBOX_IMAGE=
TENKI_SANDBOX_SNAPSHOT_ID=
# Shared only by the Vercel health endpoints, status Worker, and executor.
# Generate at least 32 random bytes; never expose it to browser code.
STATUS_PROBE_SECRET=
CLOSESPAN_INTERNAL_BASE_URL=https://www.closespan.com
