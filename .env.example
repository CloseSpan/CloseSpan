# Use demo only for local seeded evaluation. Production requires a Google
# session whose verified email exists in workspace_members.
APP_MODE=production

# Google is the only sign-in provider. Create an OAuth 2.0 Web client and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
# Generate AUTH_SECRET with: openssl rand -hex 32. Docker and reverse-proxy
# deployments must sanitize forwarded host headers before enabling trust.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Provision the first production owner after migrate:
# PRODUCTION_OWNER_EMAIL=you@company.com \
# PRODUCTION_OWNER_NAME="Your Name" \
# npm run db:provision-owner
PRODUCTION_OWNER_EMAIL=
PRODUCTION_OWNER_NAME=
PRODUCTION_ORG_ID=org_feelow
PRODUCTION_ORG_NAME=Feelow AI

# Optional GitHub App install link shown during workspace setup.
GITHUB_APP_INSTALL_URL=

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://feedbackflow:feedbackflow_local@localhost:5432/feedbackflow
DATABASE_SSL=false
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# Required before API keys can be saved from Settings. Generate 32 random bytes
# and store the base64 value only in .env.local or KMS/Secrets Manager.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER=xai
AI_MODEL=grok-4.5
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=3000

# Environment-managed credentials remain supported as a fallback. Settings-
# managed credentials are encrypted per organization and take precedence.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
