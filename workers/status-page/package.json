{
  "name": "@closespan/status-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run check:deploy",
    "check:deploy": "wrangler deploy --dry-run --outdir=/tmp/closespan-status-page-dry-run",
    "db:migrate:local": "wrangler d1 migrations apply closespan-status --local",
    "dev": "npm run build && wrangler dev --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "jose": "^6.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.4",
    "wrangler": "^4.114.0"
  }
}
