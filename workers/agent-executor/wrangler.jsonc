{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "closespan-agent-executor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "queues": {
    "producers": [
      { "binding": "AGENT_RUNS", "queue": "closespan-agent-runs" }
    ],
    "consumers": [
      {
        "queue": "closespan-agent-runs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
