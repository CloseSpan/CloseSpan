{
  "name": "closespan",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-runner.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-runner.mjs seed",
    "db:verify": "node --env-file-if-exists=.env.local scripts/db-verify.mjs",
    "db:provision-owner": "node --env-file-if-exists=.env.local scripts/provision-owner.mjs",
    "db:provision-demo": "node --env-file-if-exists=.env.local scripts/provision-demo.mjs",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:executor": "npm --prefix workers/agent-executor exec tsc -- --noEmit",
    "check": "npm run lint && npm test && npm run build && npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@pipedream/sdk": "^3.1.2",
    "@tenkicloud/sandbox": "^0.5.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/sdk": "^1.28.10",
    "cloudflare": "^7.0.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  }
}
